{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "resolveJsonModule": true,
    "noEmitOnError": true,
    "jsx": "react-jsx"
  },
  "include": ["src", "src/**/*.json"],
  "exclude": ["node_modules", "dist"]
}
